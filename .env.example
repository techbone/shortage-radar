# Zetaris (data layer). Create the API key in the Zetaris UI at http://localhost:3000 (Management, API Tokens).
# The hospital's Postgres is registered inside Zetaris (zetaris/02_hospital.sql); the app never connects to it directly.
# In docker compose the app uses http://host.docker.internal:8888/api/v1.0 automatically.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider), from Nightshift's Console.
# In docker compose the app uses http://host.docker.internal:8088/v1 automatically.
# The NVIDIA key goes in Nightshift's Providers tab, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto

# Optional: free key from open.fda.gov raises the limit from 1,000 to 120,000 requests a day (snapshot job only)
OPENFDA_API_KEY=

# Runtime behaviour
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000
