# Zetaris (data layer). Create the API key in the Zetaris UI at http://localhost:3000.
# Inside Docker use http://host.docker.internal:8888/api/v1.0
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider), from Nightshift's Console.
# Inside Docker use http://host.docker.internal:8088/v1
# The NVIDIA key goes in Nightshift's Providers tab, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto

# Hospital database (synthetic data, runs in docker compose)
HOSPITAL_DB_URL=postgres://radar:radar@localhost:5433/hospital

# Optional: free key from open.fda.gov raises the limit from 1,000 to 120,000 requests a day
OPENFDA_API_KEY=

# Runtime behaviour
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000
